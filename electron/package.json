{
  "name": "csdm-bridge-shell",
  "version": "3.2.8",
  "private": true,
  "description": "Electron shell driving the Python engine over the JSON/stdio bridge.",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:mock-css": "node scripts/extract-mock-css.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "test": "vitest run",
    "e2e": "playwright test --config playwright.config.mjs",
    "e2e:update": "playwright test --config playwright.config.mjs --update-snapshots"
  },
  "build": {
    "appId": "com.csdm.batch-clips-generator",
    "productName": "CSDM Batch Clips Generator",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "preload.js",
      "lifecycle.js",
      "renderer/dist/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "CSDM-Batch-Clips-Generator.exe"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.23",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4"
  }
}
